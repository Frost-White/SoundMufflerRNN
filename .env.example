# Copy to .env on the server (never commit .env). Generate secrets: openssl rand -hex 32
POSTGRES_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-secret
# Include :5173 when using Vite dev (npm run dev) against Docker backend on :8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
ENHANCE_WEB_RATE_LIMIT=30
ENHANCE_WEB_RATE_WINDOW_SECONDS=60
ENHANCE_API_FREE_RATE_LIMIT=30
ENHANCE_API_FREE_RATE_WINDOW_SECONDS=900
ENHANCE_API_PRO_RATE_LIMIT=15
ENHANCE_API_PRO_RATE_WINDOW_SECONDS=60
ENHANCE_MAX_UPLOAD_BYTES=2097152
