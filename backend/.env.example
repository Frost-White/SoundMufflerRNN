DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/soundmuffler
# Never commit backend/.env — use openssl rand -hex 32 on the server
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENHANCE_WEB_RATE_LIMIT=30
ENHANCE_WEB_RATE_WINDOW_SECONDS=60
ENHANCE_API_FREE_RATE_LIMIT=30
ENHANCE_API_FREE_RATE_WINDOW_SECONDS=900
ENHANCE_API_PRO_RATE_LIMIT=15
ENHANCE_API_PRO_RATE_WINDOW_SECONDS=60
ENHANCE_MAX_UPLOAD_BYTES=2097152
